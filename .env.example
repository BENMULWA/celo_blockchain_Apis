# ─── Database ────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=celo_baas_gateway

# ─── Partner JWT (signs the session tokens issued by /v1/auth/token) ──────
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ─── Celo chain ─────────────────────────────────────────────────────────
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# HD mnemonic used to derive one deposit address per (partner, external user).
# Never commit the real value. The private key for a given index is re-derived
# on demand and never stored.
CELO_MNEMONIC=

# Treasury: signs withdrawals/sweeps and receives swept deposits.
CELO_TREASURY_PK=
CELO_TREASURY_ADDRESS=

# Optional overrides — defaults are the official Celo mainnet contracts.
# CELO_CUSD_CONTRACT=0x765DE816845861e75A25fCA122bb6898B8B1282a
# CELO_USDC_CONTRACT=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
# CELO_USDT_CONTRACT=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e

# ─── Withdrawal guardrails (per partner, per asset) ────────────────────────
CELO_MAX_WITHDRAWAL_PER_TX=20
CELO_MAX_WITHDRAWAL_PER_DAY=20

# ─── Deposit watcher tuning ─────────────────────────────────────────────
CELO_WATCHER_INTERVAL_SECONDS=6
CELO_WATCHER_MAX_LOOKBACK_BLOCKS=2000
CELO_WATCHER_SCAN_CHUNK_BLOCKS=150
CELO_SWEEP_GAS_LIMIT=200000
CELO_GAS_TOPUP_BUFFER_PCT=0.25

# ─── Outbound partner webhooks ──────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
CELO_HD_ACCOUNT_INDEX=5
